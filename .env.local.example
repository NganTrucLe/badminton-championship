# Copy this file to .env.local and fill in real values. .env.local is gitignored — never commit it.

# Supabase project URL (public, safe to expose client-side).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (new-style key, safe to expose client-side). Prefer this over the
# legacy anon key for new projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon key — kept for local-dev compatibility (e.g. `supabase start` prints an anon key,
# not a publishable key). The app falls back to this if NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is unset.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
